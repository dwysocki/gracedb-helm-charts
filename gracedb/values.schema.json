{
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "required": [
        "cert_manager",
        "distributed",
        "sandboxed",
        "alerts",
        "storageClassName",
        "database",
        "publicName",
        "gracedb"
    ],
    "properties": {
        "traefik":{
            "type": "object",
            "required": [
                "install"
            ],
            "properties": {
                "install": {
                    "type": "boolean",
                    "description": "If *true* install the Traefik Helm chart"
                }
            }

        },
        "cert_manager": {
            "type": "object",
            "description": "cert-manager.io support configuration",
            "required": [
                "enabled",
                "install"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "If *true* enabled automatic creation of TLS certificates using cert-manager.io operator"
                },
                "install": {
                    "type": "boolean",
                    "description": "If *true* install the cert-manager.io operator"
                },
                "issuer": {
                    "type": "object",
                    "description": "issuer to use for the TLS certificate (if no issuer is given a self-signed certificate is created)",
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "the Issuer resource name"
                        },
                        "kind": {
                            "type": "string",
                            "description": "the issuer resource type: either Issuer or ClusterIssuer",
                            "oneOf": [
                                {
                                    "const": "Issuer"
                                },
                                {
                                    "const": "ClusterIssuer"
                                }
                            ]
                        }
                    }
                }
            }
        },
        "distributed": {
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "If *true* enables distributed deployment (will use a distributed version of postgreSQL)"
                }
            }
        },
        "sandboxed": {
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "If *true* deploys a sandboxed version of GraceDB (without shibboleth authentication). This is required for local deployments."
                }
            }
        },
        "alerts": {
            "type": "object",
            "required": [
                "igwn"
            ],
            "properties": {
                "igwn": {
                    "type": "boolean",
                    "description": "If *true* enables the IGWN-alert overseer"
                }
            }
        },
        "storageClassName": {
            "type": "string",
            "description": "Name of the k8s storage class to be used in PVCs"
        },
        "storageClassNameRWX": {
            "type": "string",
            "description": "Name of the k8s storage class to be used in ReadWriteMany PVCs (only used in distributed deployments)"
        },
        "database": {
            "type": "object",
            "required": [
                "name",
                "user",
                "storageCapacity"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the (postgreSQL) database to be used by GraceDB"
                },
                "user": {
                    "type": "string",
                    "description": "Name of the DB user for GraceDB"
                },
                "storageCapacity": {
                    "type": "string",
                    "description": "Storage capacity to be allocated for postgreSQL's PVC"
                },
                "readReplicas": {
                    "type": "integer",
                    "description": "The number of read replicas for the database (only relevant if `distributed.enabled` is *true*"
                }
            }
        },
        "publicName": {
            "type": "string",
            "description": "The public FQDN of the GraceDB webserver (will also be used by the gracedb api client when making requests)"
        },
        "tier": {
            "type": "object",
            "properties": {
                "sentryEnvironment": {
                    "type": "string",
                    "description": "Name of the Sentry environment"
                },
                "supportContact": {
                    "type": "string",
                    "description": "Support contact (used by Shibboleth)"
                }
            }
        },
        "gracedb": {
            "type": "object",
            "required": [
                "image",
                "storage",
                "resources",
                "djangoSuperuserName",
                "djangoSuperuserEmail",
                "igwnAlertAuth",
                "igwnAlertServer",
                "igwnAlertGroup"
            ],
            "properties": {
                "image": {
                    "type": "string",
                    "description": "The GraceDB container image to be used."
                },
                "storage": {
                    "type": "object",
                    "required": [
                        "capacity"
                    ],
                    "properties": {
                        "capacity": {
                            "type": "string",
                            "description": "The storage capacity to be allocated for the GraceDB data PVC."
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "required": [
                        "cpu",
                        "memory"
                    ],
                    "properties": {
                        "cpu": {
                            "type": "number",
                            "description": "The number of CPUs to allocate for the GraceDB pod"
                        },
                        "memory": {
                            "type": "string",
                            "description": "The amount of memory to allocate for the GraceDB pod"
                        }
                    }},
                "gunicorn": {
                    "type": "object",
                    "required": [
                        "worker",
                        "threads"
                    ],
                    "properties": {
                        "worker": {
                            "type": "number",
                            "description": "The number of gunicorn workers"
                        },
                        "threads": {
                            "type": "number",
                            "description": "The number of threads for gunicorn worker"
                        }
                    }
                },
                "livenessProbe": {
                    "type": "object",
                    "required": [
                        "failureThreshold",
                        "initialDelaySeconds",
			"periodSeconds"
                    ],
                    "properties": {
                        "failureThreshold": {
                            "type": "number",
                            "description": "Number of probe failures before Pod restart"
                        },
                        "initialDelaySeconds": {
                            "type": "number",
                            "description": "Wait time before first probe"
                        },
                        "periodSeconds": {
                            "type": "number",
                            "description": "Time interval between probes"
                        },
                        "timeoutSeconds": {
                            "type": "number",
                            "description": "Probe timeout"
                        },
                        "successThreshold": {
                            "type": "number",
                            "description": "Minimum consecutive successes for the probe to be considered successful"
                        },
                        "terminationGracePeriodSeconds": {
                            "type": "number",
                            "description": "Grace period to wait before triggering a shut down"
                        }
                    }
		},
                "readinessProbe": {
                    "type": "object",
                    "required": [
                        "initialDelaySeconds",
			"periodSeconds"
                    ],
                    "properties": {
                        "initialDelaySeconds": {
                            "type": "number",
                            "description": "Wait time before first probe"
                        },
                        "periodSeconds": {
                            "type": "number",
                            "description": "Time interval between probes"
                        },
                        "timeoutSeconds": {
                            "type": "number",
                            "description": "Probe timeout"
                        },
                        "successThreshold": {
                            "type": "number",
                            "description": "Minimum consecutive successes for the probe to be considered successful"
                        },
                        "failureThreshold": {
                            "type": "number",
                            "description": "Number of probe failures before Pod restart"
                        }
                    }
		},
                "djangoSuperuserName": {
                    "type": "string",
                    "description": "The name of the Django superuser (will be created if not already present)."
                },
                "djangoSuperuserEmail": {
                    "type": "string",
                    "description": "The email of the Django superuser."
                },
                "igwnAlertAuth": {
                    "type": "boolean",
                    "description": "Enable authenticated connections to the Hopskotch server."
                },
                "igwnAlertServer": {
                    "type": "string",
                    "description": "DNS name of the Hopskotch server."
                },
                "igwnAlertGroup": {
                    "type": "string",
                    "description": " Prefix for Kafka topics."
                },
                "replicaCount": {
                    "type": "integer",
                    "description": "The number of replicas for the GraceDB server"
                },
                "pvcName": {
                    "type": "string",
                    "description": "Name of an external PVC of type RWX to be used as file storage."
                }
            }
        },
        "secrets": {
            "description": "Secret (optional) values used to populate k8s secrets",
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "enabled": {
                    "description": "If *true* k8s secrets will be created and populated using the defined chart values.",
                    "type": "boolean"
                },
                "djangoSecretKey": {
                    "description": "The Django secret key used by GraceDB webserver.",
                    "type": "string"
                },
                "djangoSuperuserPassword": {
                    "description": "The password for the automatically created Django superuser.",
                    "type": "string"
                },
                "dbPassword": {
                    "description": "The password for GraceDB's postgreSQL DB.",
                    "type": "string"
                },
                "igwnAlertUsername": {
                    "description": "The username of the IGWN-alert broker.",
                    "type": "string"
                },
                "igwnAlertPassword": {
                    "description": "The password of the IGWN-alert broker.",
                    "type": "string"
                },
                "shibbolethCert": {
                    "description": "The x509 certificate to be used for Shibboleth.",
                    "type": "string"
                },
                "shibbolethPKey": {
                    "description": "The x509 private key to be used for Shibboleth.",
                    "type": "string"
                }
            }
        },
        "postgres": {
            "type": "object",
            "properties": {
                "image": {
                    "description": "The PostgreSQL container image to be used (for non replicated deployment)",
                    "type": "string"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "description": "The number of CPUs to allocate for the PostgreSQL pod",
                            "type": "number"
                        },
                        "memory": {
                            "description": "The amount of memory to allocate for the PostgreSQL pod",
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
